# === クライアント（Expo） ===
# 1 / true のとき課金（RevenueCat）だけモック。採点（Gemini）は実リクエストする
# 認証までモックしたいときは EXPO_PUBLIC_SUPABASE_URL を空にする
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=goog_xxx
EXPO_PUBLIC_USE_MOCKS=true
EXPO_PUBLIC_TERMS_URL=https://docs.google.com/document/d/e/2PACX-1vTL3BWhJjqpCTwHVwMMP-VTs23cnsOIZEXPYkpaPOuPXXwoWup__BCyx1TTpTk7WF9zG6oCiKQdgA8d/pub
EXPO_PUBLIC_PRIVACY_URL=https://docs.google.com/document/d/e/2PACX-1vTWB0rsfyNkGyv-gXf_BiRjPNjXNdmyxyWvVnNpDi71jVD0ETbc7ZFM2IOuO6Ah6tl-fb6Lx0FUGLNQ/pub
EXPO_PUBLIC_TOKUSHOHO_URL=https://docs.google.com/document/d/e/2PACX-1vRnrBL151s-KjWlLSK4CfdQFNvcQq8EG_DV69BC7vOOl_j0i53IEoatHzkBwPtQGvyBx5n9Xz6PTnMq/pub
EXPO_PUBLIC_OAUTH_REDIRECT_URL=maru://auth/callback

# EAS プロジェクト（eas init 後の UUID。未設定なら eas.json / ダッシュボード側で紐付け）
EAS_PROJECT_ID=

# === Edge Functions のみ（クライアントに出さない） ===
# npx supabase secrets set GEMINI_API_KEY=...
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
MOCK_GEMINI=1
REPLICATE_API_TOKEN=
REPLICATE_INPAINT_MODEL=allenhooo/lama
MOCK_INPAINT=1
REVENUECAT_WEBHOOK_SECRET=
