{
  "name": "maru",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "eas:dev:ios": "npx eas build --profile development --platform ios",
    "eas:dev:android": "npx eas build --profile development --platform android",
    "eas:prod:ios": "npx eas build --profile production --platform ios",
    "supabase:types": "npx supabase gen types typescript --local > src/types/database.ts",
    "test:grade-scan": "node scripts/test-grade-scan.mjs",
    "test:grade-scan:deno": "deno test --allow-env --allow-read --allow-net supabase/functions/grade-scan/grade-scan.test.ts",
    "grade-scan:mock": "deno run --allow-env --allow-read --allow-net supabase/functions/grade-scan/scripts/run-mock.ts",
    "test:inpaint": "node scripts/test-inpaint.mjs",
    "inpaint:mock": "node scripts/run-inpaint-mock.mjs",
    "test:print-review": "node scripts/test-print-review.mjs",
    "test:leech": "node scripts/test-leech.mjs",
    "test:scan-ui": "node scripts/test-scan-ui.mjs",
    "test:account": "node scripts/test-account.mjs",
    "print:preview": "node scripts/serve-print-preview.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.49.4",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "nativewind": "^4.1.23",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-document-scanner-plugin": "^2.0.4",
    "react-native-purchases": "^8.9.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2"
  }
}
